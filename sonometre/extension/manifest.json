{
  "manifest_version": 3,
  "name": "MEUST — Compagnon Deezer",
  "short_name": "MEUST Deezer",
  "version": "1.1.0",
  "description": "Pilote le lecteur Deezer de ton navigateur depuis MEUST : lecture, pause, pistes, progression, volume et métadonnées.",
  "permissions": [
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "https://www.deezer.com/*",
    "https://deezer.com/*",
    "https://sopp24.github.io/SOPP-agents/sonometre/*"
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://sopp24.github.io/SOPP-agents/sonometre/*"
      ],
      "js": [
        "bridge.js"
      ],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_title": "MEUST — Compagnon Deezer"
  }
}
